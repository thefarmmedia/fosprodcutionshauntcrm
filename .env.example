# ── Database (Supabase) ─────────────────────────────────────────────
# Leave these empty and the app runs in DEMO MODE (data saved in this browser only).
# Fill them in (Supabase → Project Settings → API) to go live for both locations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Lets the website application forms drop applicants straight in.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the websites send with applications: /api/inbound/application?key=...
INBOUND_APPLICATION_KEY=

# ── Text messages (Twilio) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="Field of Screams <crew@fieldofscreamsbranson.com>"
